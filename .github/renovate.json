{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "conflicted",
  "gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "Release when a shipped composite action changes",
      "matchFileNames": ["**/action.yaml"],
      "addLabels": ["patch"]
    }
  ],
  "customManagers": [
    {
      "description": "Track the pinned ghalint version in verify-actions/action.yaml",
      "customType": "regex",
      "managerFilePatterns": ["/^verify-actions/action\\.yaml$/"],
      "matchStrings": ["GHALINT_VERSION: \"(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "suzuki-shunsuke/ghalint"
    },
    {
      "description": "Track the pinned oxfmt version in autofix-text action",
      "customType": "regex",
      "managerFilePatterns": ["/^autofix-text\\/action\\.yaml$/"],
      "matchStrings": ["OXFMT_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "npm",
      "depNameTemplate": "oxfmt"
    }
  ]
}
